# ===================== 回调函数 =====================
async def my_callback(station_id, module_input):
    """
    单场站处理回调

    Args:
        station_id: str, 场站ID
        module_input: dict, 模块输入数据

    Returns:
        dict: 必须包含 'station_id' 字段的结果字典
        None: 处理失败
    """
    # 检验数据质量
    if module_input.get("_data_quality", {}).get("availability_ratio", 0) < 0.5:
        logging.warning(f"场站 {station_id} 数据质量过低，跳过处理")
        return None
    try:
        # 调用模型推理
        result = await my_model_predict(module_input)

        # 在结果中添加 station_id（必需）
        result["station_id"] = station_id

        logging.info(f"场站 {station_id} 处理成功")
        return result

    except Exception as e:
        logging.error(f"场站 {station_id} 处理失败: {e}", exc_info=True)
        return None  # 返回None表示失败,不会阻塞批次上传


async def batch_upload_handler(producer, output_topic, batch_id, results_list):
    """
    批次上传回调

    Args:
        producer: Kafka生产者
        output_topic: 输出topic
        batch_id: str, 批次ID
        results_list: list, 成功场站的结果列表
    """
    if not results_list:
        logging.warning(f"批次 {batch_id} 没有成功的结果,跳过上传")
        return

    payload = {
        "batch_id": batch_id,
        "module": MODULE_NAME,
        "timestamp": time.time(),
        "stations_count": len(results_list),
        "results": results_list,  # 所有场站的结果列表
    }

    try:
        await producer.send(output_topic, payload)
        logging.info(f"批次上传成功: {batch_id}, {len(results_list)} 个场站")
    except Exception as exc:
        logging.error(f"批次上传失败: {batch_id}", exc_info=exc)


# ===================== 主函数 =====================
async def main():
    """主函数 - 启动数据分析服务"""

    # 获取输出 topic
    output_topic = MODULE_OUTPUT_TOPICS.get(MODULE_NAME)
    if not output_topic:
        raise RuntimeError(f"未配置模块 {MODULE_NAME} 的输出 topic")

    logging.info(f"启动模块: {MODULE_NAME}")
    logging.info(f"输出 topic: {output_topic}")
    if ENABLE_MOCK:
        logging.warning("⚠️  虚拟数据模式已启用（MOCK_DATA=1），仅用于测试！")

    # 创建 Kafka 生产者
    producer = AsyncKafkaProducerClient(KAFKA_CONFIG)
    await producer.start()
    logging.info("Kafka 生产者已启动")

    # 创建数据分析服务
    service = AsyncDataAnalysisService(module_name=MODULE_NAME)

    # ----------------------------------------------------------------
    # 虚拟数据初始化
    # ----------------------------------------------------------------
    mock_mgr = None
    mock_task = None

    if ENABLE_MOCK:
        mock_mgr = build_mock_manager(service)

        # ✅ 注册场站初始化钩子：在 _station_worker 启动前同步注入，零时间窗口
        # 对 Kafka 动态发现的新场站兜底，无需手动干预
        service._station_init_hook = make_station_init_hook(mock_mgr)

        # ✅ 对环境变量指定的场站立即预注入（Kafka 消息到达前先填充数据）
        # 与 mock_startup_inject 互为补充：
        #   MOCK_STATIONS 适合命令行快速指定；mock_startup_inject 适合代码中固定配置
        if MOCK_STATIONS:
            logging.info(f"[MockData] MOCK_STATIONS 预注入: {MOCK_STATIONS}")
            for station_id in MOCK_STATIONS:
                results = mock_mgr.inject_all(station_id, force=MOCK_FORCE)
                success = [t for t, ok in results.items() if ok]
                logging.info(f"[MockData] 预注入 {station_id}: {success}")

        # ✅ 代码中固定的启动注入（根据 build_mock_manager 中的场景配置）
        mock_startup_inject(mock_mgr)

        # 启动后台任务（非 force: 兜底一次；force: 持续刷新）
        mock_task = asyncio.create_task(
            mock_auto_inject_loop(mock_mgr, service, service._stop_event)
        )

    # ----------------------------------------------------------------
    # 定义批次上传处理器并启动服务
    # ----------------------------------------------------------------
    async def upload_handler(batch_id, results_list):
        await batch_upload_handler(producer, output_topic, batch_id, results_list)

    await service.start(callback=my_callback, batch_upload_handler=upload_handler)
    logging.info("数据分析服务已启动")

    try:
        print("\n" + "=" * 60)
        print(f"服务已启动 - 模块: {MODULE_NAME}")
        if ENABLE_MOCK:
            mode = "已启用（强制覆盖所有 topic）" if MOCK_FORCE else "已启用（仅补全缺失 topic）"
            print(f"虚拟数据: {mode}")
            print(f"预注入场站: {MOCK_STATIONS or '（等待 Kafka 动态发现）'}")
            for rule in mock_mgr.get_registry_info():
                print(f"  [{rule['station_id']:>12}] {rule['topic']} -> {rule['provider']}")
        print(f"多消费者模式: {service.consumer._multi_consumer_mode}")
        if service.consumer._multi_consumer_mode:
            print(f"订阅的 topic 数量: {len(service.consumer.topics)}")
            for topic in service.consumer.topics:
                print(f"  - {topic}")
        print("按 Ctrl+C 停止服务...")
        print("=" * 60 + "\n")

        # 主循环
        iteration = 0
        while True:
            iteration += 1

            # 每隔 10 次迭代显示状态
            if iteration % 10 == 0:
                status = service.get_station_status()
                logging.info(f"第 {iteration} 次循环 - 活跃场站数: {len(status)}")

                # 虚拟数据模式：打印各场站 topic 覆盖缺口
                if ENABLE_MOCK and mock_mgr:
                    for station_id in service.dispatcher.data_cache:
                        available = [
                            t
                            for t in service.dispatcher.data_cache[station_id]
                            if service.dispatcher.get_topic_window(station_id, t)
                        ]
                        missing = [
                            t for t in mock_mgr.registered_topics()
                            if t not in available
                        ]
                        if missing:
                            logging.info(
                                f"[MockData] {station_id} 仍缺失: {missing}"
                            )

                # 显示消息积压信息（多消费者模式）
                if service.consumer._multi_consumer_mode:
                    lag_info = await service.consumer.get_lag_info()
                    if lag_info:
                        logging.info("消息积压情况:")
                        for topic, partitions in lag_info.items():
                            total_lag = sum(p.get("lag", 0) for p in partitions.values())
                            logging.info(f"  {topic}: {len(partitions)} 个分区, 总积压: {total_lag} 条")
                            for partition_id, info in partitions.items():
                                logging.info(
                                    f"    分区 {partition_id}: "
                                    f"当前offset={info.get('current_offset', 'N/A')}, "
                                    f"最新offset={info.get('end_offset', 'N/A')}, "
                                    f"积压={info.get('lag', 'N/A')} 条"
                                )

            for _ in range(10):
                await asyncio.sleep(1)

    except (KeyboardInterrupt, asyncio.CancelledError) as e:
        logging.info(f"收到停止信号: {type(e).__name__}，开始停机...")

    finally:
        logging.info("正在停止服务...")
        await service.stop()

        if mock_task and not mock_task.done():
            mock_task.cancel()
            try:
                await mock_task
            except asyncio.CancelledError:
                pass

        logging.info("正在停止生产者...")
        await producer.stop()

        logging.info("服务已完全停止")


if __name__ == "__main__":
    """
    程序入口

    运行前确保:
    1. 已安装 data_analysis 包
    2. 当前目录下有 config.yaml 配置文件
    3. config.yaml 中正确配置了 module_name 和 Kafka 连接信息

    本地测试（补全缺失 topic）:
        MOCK_DATA=1 python main.py
        MOCK_DATA=1 MOCK_STATIONS=1001,1002 python main.py

    强制用虚拟数据覆盖所有 topic（完全脱离 Kafka，纯本地测试）:
        MOCK_DATA=1 MOCK_FORCE=1 MOCK_STATIONS=1001 python main.py
    """
    config_file = Path("config.yaml")
    if not config_file.exists():
        print("错误: 找不到 config.yaml 配置文件")
        print("请从 config.yaml.example 复制并修改配置")
        sys.exit(1)

    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    try:
        loop.run_until_complete(main())
    except KeyboardInterrupt:
        logging.info("捕获到键盘中断")
    finally:
        logging.info("关闭事件循环...")
        loop.close()
        logging.info("程序已退出")
